# dependências
/node_modules
/.pnp
.pnp.*
.yarn/*

# next
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# produção
/build

# ambiente — NUNCA versionar chaves
.env
.env*.local
.env.production

# dados do Postgres local ficam em volume do Docker, não no repo.
# As linhas de SQLite continuam aqui só como rede de proteção: quem rodou o
# projeto antes da migração para Postgres tem um prisma/dev.db sobrando.
/prisma/*.db
/prisma/*.db-journal

# mídia gerada localmente
/public/midia/*
!/public/midia/.gitkeep

# logs / sistema
npm-debug.log*
yarn-error.log*
.DS_Store
*.pem

# editor
.vscode/*
!.vscode/extensions.json
.idea

# Python (os scripts de montagem)
__pycache__/
*.pyc

# episódios montados e logs de montagem (saída do dashboard do canal)
/renders/*
!/renders/.gitkeep
/.niche-jobs/

# acervo local (obras, ilustrações, trilhas) — mídia não entra no histórico
/acervo/
