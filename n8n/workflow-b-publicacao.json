      "name": "Ler Credenciais",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -600,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  MAX(CASE WHEN chave = 'meta_long_lived_token' THEN valor END) AS token,\n  MAX(CASE WHEN chave = 'ig_user_id' THEN valor END) AS ig_user_id,\n  COALESCE(MAX(CASE WHEN chave = 'meta_graph_version' THEN valor END), 'v21.0') AS versao,\n  MAX(CASE WHEN chave = 'meta_long_lived_token' THEN atualizado_em END) AS token_atualizado_em\nFROM config;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres DB"
        }
      }
    },
