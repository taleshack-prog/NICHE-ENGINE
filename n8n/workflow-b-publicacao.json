        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ media_type: 'REELS', video_url: $json.url, caption: $json.legenda, share_to_feed: true }, $json.coverUrl ? { cover_url: $json.coverUrl } : {})) }}",
