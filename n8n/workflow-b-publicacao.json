      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, titulo, formato, legenda, hashtags, midia_paths\nFROM posts\nWHERE status = 'agendado' AND agendado_para <= NOW()\nORDER BY agendado_para ASC\nLIMIT 10;",
