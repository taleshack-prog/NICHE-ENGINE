    {
      "id": "b8",
      "name": "Preparar Imagens",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        -160
      ],
      "parameters": {
        "jsCode": "const post = $input.first().json;\n// midia_paths é TEXT com JSON (ver decisão 2 do schema): parse sempre funciona,\n// em SQLite e em PostgreSQL.\nconst midia = typeof post.midia_paths === 'string' ? JSON.parse(post.midia_paths || '[]') : (post.midia_paths || []);\nconst imagens = midia.filter(m => m.tipo === 'imagem');\n\nif (imagens.length < 2) throw new Error('Carrossel exige no mínimo 2 imagens: ' + post.titulo);\nif (imagens.length > 10) throw new Error('Carrossel aceita no máximo 10 imagens: ' + post.titulo);\n\n// A capa gerada pelo dashboard mora em /midia/capas/... — caminho local. O Meta\n// BAIXA o arquivo do lado dele, então precisa de endereco publico.\nconst BASE = ($env.APP_PUBLIC_URL || '').replace(/\\/+$/, '');\nfunction publica(u) {\n  if (/^https?:\\/\\//i.test(u)) return u;\n  if (!BASE) throw new Error('Midia local (' + u + ') e APP_PUBLIC_URL vazia no n8n: o Meta nao alcanca localhost.');\n  return BASE + '/' + u.replace(/^\\/+/, '');\n}\n\nreturn imagens.map(m => ({ json: { postId: post.id, legenda: post.legenda || '', url: publica(m.url) } }));"
      }
    },
    {
      "id": "b9",
      "name": "Criar Container Filho",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -160
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('Ler Credenciais').first().json.versao }}/{{ $('Ler Credenciais').first().json.ig_user_id }}/media",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $('Ler Credenciais').first().json.token }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ image_url: $json.url, is_carousel_item: true }) }}",
        "options": {}
      }
    },
    {
      "id": "b10",
      "name": "Agrupar Containers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        940,
        -160
      ],
      "parameters": {
        "jsCode": "const post = $('Um Post Por Vez').first().json;\nconst ids = $input.all().map(i => i.json.id).filter(Boolean);\nif (!ids.length) throw new Error('Nenhum container filho criado para ' + post.titulo);\nreturn [{ json: { childrenIds: ids.join(','), legenda: post.legenda || '' } }];"
      }
    },
