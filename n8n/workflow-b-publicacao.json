    {
      "id": "b21",
      "name": "Montar UPDATE",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2480,
        -160
      ],
      "parameters": {
        "jsCode": "// Escape de literal SQL. Apóstrofo em gancho (\"Ninguém 'te' conta\") quebra\n// qualquer INSERT montado por interpolação — por isso todo texto passa aqui.\nconst q = (v) => (v === null || v === undefined || v === '' ? 'NULL' : \"'\" + String(v).replace(/'/g, \"''\") + \"'\");\nconst n = (v) => (v === null || v === undefined || v === '' || isNaN(Number(v)) ? 'NULL' : String(Number(v)));\n\nconst igPostId = $input.first().json.id;\nconst postId = $('Um Post Por Vez').first().json.id;\nif (!igPostId) throw new Error('media_publish não devolveu id');\n\nconst sql = `UPDATE posts SET status = 'publicado', publicado_em = NOW(), atualizado_em = NOW(), erro_publicacao = NULL, ig_post_id = ${q(igPostId)} WHERE id = ${q(postId)};`;\nreturn [{ json: { sql } }];"
      }
