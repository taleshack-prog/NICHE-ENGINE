# ─────────────────────────────────────────────────────────────
# NICHE ENGINE — variáveis de ambiente
# Copie para .env e preencha. Nada aqui é obrigatório na Fase 1:
# integrações ausentes retornam erro amigável, não quebram a app.
# ─────────────────────────────────────────────────────────────

# ---- Banco de dados ----
# PostgreSQL em dev e em prod (ver comentário do datasource em prisma/schema.prisma).
# O banco de dev sobe com `npm run db:up` — usuário e senha batem com o
# docker-compose.yml. Em produção, troque só a DATABASE_URL.
#
# Porta do host. 5433 e não 5432 porque a 5432 costuma já estar ocupada por um
# Postgres de sistema ou de outro projeto. Se a 5433 também estiver, troque as
# DUAS linhas abaixo para a mesma porta livre.
DB_PORT="5433"
DATABASE_URL="postgresql://niche:niche@localhost:5433/niche?schema=public"

# ---- Autenticação (single user) ----
# Segredo de assinatura do cookie de sessão. Gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_USERNAME="admin"
AUTH_PASSWORD=""
# Em dev, "true" ignora o login por completo.
AUTH_DISABLED="true"

# ---- IA (Fase 2) ----
ANTHROPIC_API_KEY=""
# Modelo por tarefa. Default: claude-sonnet-5 nas quatro.
#
# Sonnet 4.5 e Haiku 4.5 (os da spec original) ainda funcionam, mas têm
# aposentadoria anunciada para "não antes de" 29/09/2026 e 15/10/2026 — alias
# aposentado vira 404 dentro do Workflow A às 06h, sem ninguém olhando.
#
# Para economizar na decomposição (a tarefa mais simples), prefira o snapshot
# datado ao alias flutuante:
#   ANTHROPIC_MODEL_DECOMPOSICAO="claude-haiku-4-5-20251001"
ANTHROPIC_MODEL_ROTEIRO=""
ANTHROPIC_MODEL_COPY=""
ANTHROPIC_MODEL_DECOMPOSICAO=""
ANTHROPIC_MODEL_RELATORIO=""

# ---- Mídia (Fase 3) ----
# Uma única credencial cobre FLUX (imagem) e Kling (vídeo), ambos via fal.ai
FAL_KEY=""
FAL_MODEL_IMAGEM="fal-ai/flux/dev"
FAL_MODEL_VIDEO="fal-ai/kling-video/v1/standard/image-to-video"

# ---- Meta / Instagram (Fase 5) ----
# APP_ID e APP_SECRET não mudam: ficam aqui.
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v21.0"
IG_USER_ID=""
# ATENÇÃO: o token de longa duração é rotacionado a cada ~50 dias pelo Workflow D.
# A FONTE DA VERDADE é a tabela `config` (chave: meta_long_lived_token).
# O valor abaixo é usado APENAS para semear a tabela na primeira execução.
META_LONG_LIVED_TOKEN=""

# ---- Notificações (opcional) ----
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
