# ─────────────────────────────────────────────────────────────
# NICHE ENGINE — variáveis de ambiente
# Copie para .env e preencha. Nada aqui é obrigatório na Fase 1:
# integrações ausentes retornam erro amigável, não quebram a app.
# ─────────────────────────────────────────────────────────────

# ---- Banco de dados ----
# PostgreSQL em dev e em prod (ver comentário do datasource em prisma/schema.prisma).
# O banco de dev sobe com `npm run db:up` — usuário e senha batem com o
# docker-compose.yml. Em produção, troque só a DATABASE_URL.
#
# Porta do host. 5433 e não 5432 porque a 5432 costuma já estar ocupada por um
# Postgres de sistema ou de outro projeto. Se a 5433 também estiver, troque as
# DUAS linhas abaixo para a mesma porta livre.
DB_PORT="5433"
DATABASE_URL="postgresql://niche:niche@localhost:5433/niche?schema=public"

# ---- Autenticação (single user) ----
# Segredo de assinatura do cookie de sessão. Gere com: openssl rand -base64 32
AUTH_SECRET=""
AUTH_USERNAME="admin"
AUTH_PASSWORD=""
# Em dev, "true" ignora o login por completo.
AUTH_DISABLED="true"

# ---- IA (Fase 2) ----
ANTHROPIC_API_KEY=""
# Modelo por tarefa. Default: claude-sonnet-5 nas quatro.
#
# Sonnet 4.5 e Haiku 4.5 (os da spec original) ainda funcionam, mas têm
# aposentadoria anunciada para "não antes de" 29/09/2026 e 15/10/2026 — alias
# aposentado vira 404 dentro do Workflow A às 06h, sem ninguém olhando.
#
# Para economizar na decomposição (a tarefa mais simples), prefira o snapshot
# datado ao alias flutuante:
#   ANTHROPIC_MODEL_DECOMPOSICAO="claude-haiku-4-5-20251001"
ANTHROPIC_MODEL_ROTEIRO=""
ANTHROPIC_MODEL_COPY=""
ANTHROPIC_MODEL_DECOMPOSICAO=""
ANTHROPIC_MODEL_RELATORIO=""

# ---- Mídia (Fase 3) ----
# Uma única credencial cobre FLUX (imagem) e Kling (vídeo), ambos via fal.ai
FAL_KEY=""
FAL_MODEL_IMAGEM="fal-ai/flux/dev"

# ATENÇÃO: kling-video/v1/standard está DEPRECATED no fal.ai ("no longer
# supported") — se você tem esse valor num .env antigo, troque. O sintoma da
# remoção seria "fila travada", não "modelo inexistente".
# Tiers `standard` custam menos por segundo e são a alavanca de custo mais
# direta do sistema: o vídeo é ~90% da conta de um Reel.
FAL_MODEL_VIDEO="fal-ai/kling-video/v2.5-turbo/pro/image-to-video"

# ---- Cadeia de Reel (voz → tempos → montagem → legenda), tudo no fal ----
FAL_MODEL_VOZ="fal-ai/kokoro/brazilian-portuguese"
FAL_MODEL_TRANSCRICAO="fal-ai/whisper"
FAL_MODEL_MONTAGEM="fal-ai/ffmpeg-api/compose"
FAL_MODEL_LEGENDA="fal-ai/auto-caption"

# Preço de um clipe de 5s, usado só para a estimativa mostrada antes de gerar.
# Tabela do fal em 28/09/2026 para v2.5-turbo/pro: US$ 0,35 por 5s.
FAL_CUSTO_CLIPE_USD="0.35"

# Teto de clipes por Reel. Roteiro de ~60s dá 13 clipes: a guarda existe para
# um roteiro longo demais não virar uma conta de US$ 5 sem aviso.
REEL_MAX_CLIPES="12"

# Corpo da legenda queimada, em pixels do vídeo final. O default do auto-caption
# é 24 (pensado para vídeo horizontal) e some num quadro vertical; 64 ficou
# grande demais no teste. 44 fica na faixa de 5-7% da largura. Ajustável também
# pelo editor, com "Refazer legenda" — que não gera clipe novo.
REEL_LEGENDA_CORPO="44"

# Velocidade da narração. 1.1 era o palpite anterior e saiu afobada, sem pausa.
# Ritmo de Reel se ganha com frase curta e corte, não com a voz correndo.
# Ajustável também no editor, com "Ouvir voz" — que custa centavos.
REEL_VOZ_VELOCIDADE="1.0"

# Fonte da capa. Por padrão usa assets/fontes/Poppins-Bold.ttf, versionada no
# repositório para a capa sair idêntica em qualquer máquina. Aponte para outro
# .ttf/.otf se quiser a tipografia da sua página.
CAPA_FONTE=""

# ---- Endereço público do dashboard (necessário só para publicar pela API) ----
# O Meta BAIXA a mídia do lado dele. As imagens do fal já são públicas, mas a
# CAPA é gerada aqui e servida em /midia/capas/... — endereço que só existe
# nesta máquina. Sem isto, "Publicar agora" recusa com mensagem explicando.
# Vale um deploy ou um túnel (cloudflared/ngrok). Sem barra no fim.
APP_PUBLIC_URL=""

# ---- Meta / Instagram (Fase 5) ----
# APP_ID e APP_SECRET não mudam: ficam aqui.
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v21.0"
IG_USER_ID=""
# ATENÇÃO: o token de longa duração é rotacionado a cada ~50 dias pelo Workflow D.
# A FONTE DA VERDADE é a tabela `config` (chave: meta_long_lived_token).
# O valor abaixo é usado APENAS para semear a tabela na primeira execução.
META_LONG_LIVED_TOKEN=""

# ---- Notificações (opcional) ----
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
